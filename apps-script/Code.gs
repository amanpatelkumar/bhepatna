// Bombay Hardware & Electricals - order store (Google Apps Script). Generated by build.mjs.
// 1. Create a Google Sheet. Extensions -> Apps Script. Delete the sample code and paste this file.
// 2. Project Settings (gear icon) -> Script properties -> Add: ADMIN_KEY = a long random text (keep it secret).
// 3. Deploy -> New deployment -> Web app -> Execute as: Me, Who has access: Anyone -> Deploy. Copy the Web app URL.
// 4. Paste that URL in admin Settings -> Orders web address, and the same ADMIN_KEY into Orders key.

const ORDERS_SHEET = "Orders";
const ORDER_HEAD = ["Order ID", "Date", "Name", "Phone", "Delivery", "Address", "Items", "Total", "Status", "Note", "Details", "Flags", "Admin flag", "Payment"];
const STATUSES = ["New", "Confirmed", "Packed", "Delivered", "Cancelled"];

    // ===== Order detail checks: flags suspicious names and phone numbers. The order is still sent. =====
    // Shared by the website and the orders script (apps-script/Code.gs is generated from this file by build.mjs).
    function checkOrderDetails(name, phone) {
      const reasons = [];
      const n = String(name || "").trim();
      let digits = String(phone || "").replace(/\D/g, "");
      if (digits.length === 12 && digits.startsWith("91")) digits = digits.slice(2);
      if (digits.length === 11 && digits.startsWith("0")) digits = digits.slice(1);
      const letters = n.replace(/[^\p{L}]/gu, "");
      const placeholders = ["test", "testing", "abc", "xyz", "xxx", "dummy", "fake", "none", "nil", "null", "na", "nothing", "unknown", "name", "user", "customer", "aaa", "bbb", "ccc", "abcd", "sample", "temp", "asdf", "qwerty"];
      if (/[0-9@#$%^&*_=+<>\[\]{}|\\\/~`]/.test(n)) reasons.push("name has numbers or symbols");
      if (letters.length < 3) reasons.push("name too short");
      else if (!/[\u0900-\u097F]/.test(n)) {
        const low = n.toLowerCase().replace(/[^a-z ]/g, " ").replace(/\s+/g, " ").trim();
        if (/(.)\1\1/.test(low)) reasons.push("repeated letters");
        if (/(asdf|qwer|zxcv|hjkl|qwe|asd|zxc|sdf|fgh|ghj)/.test(low)) reasons.push("keyboard pattern");
        if (low.split(" ").some(w => placeholders.indexOf(w) >= 0)) reasons.push("placeholder name");
        if (letters.length >= 4 && !/[aeiouy]/.test(low)) reasons.push("no vowels");
      }
      if (digits.length !== 10) reasons.push("phone is not 10 digits");
      else {
        if (!/^[6-9]/.test(digits)) reasons.push("phone is not a mobile number");
        if (/^(\d)\1{9}$/.test(digits)) reasons.push("phone repeats one digit");
        if (["1234567890", "0123456789", "9876543210", "0987654321"].indexOf(digits) >= 0) reasons.push("phone is a pattern");
      }
      return reasons;
    }


function adminKey_() { return PropertiesService.getScriptProperties().getProperty("ADMIN_KEY") || ""; }
function sheet_() {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let sh = ss.getSheetByName(ORDERS_SHEET);
  if (!sh) { sh = ss.insertSheet(ORDERS_SHEET); }
  sh.getRange(1, 1, 1, ORDER_HEAD.length).setValues([ORDER_HEAD]);
  sh.setFrozenRows(1);
  return sh;
}
function out_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }
function findRow_(sh, id) {
  const rows = sh.getDataRange().getValues();
  for (let i = 1; i < rows.length; i++) { if (rows[i][0] === id) return i + 1; }
  return 0;
}

// Website -> new order (no key needed). Admin -> status / mark (key needed).
function doPost(e) {
  let d;
  try { d = JSON.parse(e.postData.contents); } catch (err) { return out_({ error: "bad request" }); }
  if (d.action === "status") {
    if (!adminKey_() || d.key !== adminKey_()) return out_({ error: "forbidden" });
    if (STATUSES.indexOf(d.status) < 0) return out_({ error: "bad status" });
    const sh = sheet_(), r = findRow_(sh, d.id);
    if (!r) return out_({ error: "not found" });
    sh.getRange(r, 9).setValue(d.status);
    return out_({ ok: true });
  }
  if (d.action === "pay") {
    if (!adminKey_() || d.key !== adminKey_()) return out_({ error: "forbidden" });
    if (["", "Paid", "Pay on delivery"].indexOf(d.payment) < 0) return out_({ error: "bad payment" });
    const sh = sheet_(), r = findRow_(sh, d.id);
    if (!r) return out_({ error: "not found" });
    sh.getRange(r, 14).setValue(d.payment);
    return out_({ ok: true });
  }
  if (d.action === "mark") {
    if (!adminKey_() || d.key !== adminKey_()) return out_({ error: "forbidden" });
    const sh = sheet_(), r = findRow_(sh, d.id);
    if (!r) return out_({ error: "not found" });
    sh.getRange(r, 13).setValue(d.mark === "Irrelevant" ? "Irrelevant" : "");
    return out_({ ok: true });
  }
  if (!d.id || !d.name || !d.phone) return out_({ error: "missing details" });
  // the same checks as the website, run again here so a forced or direct submission is still flagged
  const flags = checkOrderDetails(d.name, d.phone).concat((d.flags || []).filter(f => checkOrderDetails(d.name, d.phone).indexOf(f) < 0));
  const items = (d.items || []).map(i => i.qty + " x " + i.name + " (" + i.brand + ", " + i.specs + ") = " + (i.price * i.qty)).join("\n");
  sheet_().appendRow([d.id, d.when || new Date(), d.name, d.phone, d.mode || "", d.address || "", items, d.total || 0, "New", "", JSON.stringify(d).slice(0, 4000), flags.join("; "), "", ""]);
  return out_({ ok: true, flags: flags });
}

// Admin -> list orders (key needed)
function doGet(e) {
  if (!adminKey_() || e.parameter.key !== adminKey_()) return out_({ error: "forbidden" });
  const rows = sheet_().getDataRange().getValues();
  rows.shift();
  return out_({ orders: rows.filter(r => r[0]).map(r => ({ id: r[0], when: String(r[1]), name: r[2], phone: r[3], mode: r[4], address: r[5], items: r[6], total: r[7], status: r[8], note: r[9], flags: r[11] || "", adminFlag: r[12] || "", payment: r[13] || "" })) });
}
